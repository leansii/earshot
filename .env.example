# Earshot configuration — copy to .env and fill in. NEVER commit your real .env.
# Tokens are loaded via *_FILE indirection where possible so secrets live in
# files/secret mounts, not in the environment of long-lived processes.

# ---- HTTP server ----
EARSHOT_HTTP_ADDR=:8080

# ---- Database (Postgres + pgvector) ----
EARSHOT_DATABASE_URL=postgres://earshot:earshot@localhost:5432/earshot?sslmode=disable

# ---- Queue backend: "memory" (dev/tests) or "river" (Postgres-backed, prod) ----
EARSHOT_QUEUE=memory

# ---- LLM provider, addressed as provider:model ----
# The fake provider needs no key and is used for offline tests/dev.
EARSHOT_LLM_MODEL=fake:classifier-v1
# For real use, one of:
#   EARSHOT_LLM_MODEL=deepseek:deepseek-v4-flash
#   EARSHOT_LLM_MODEL=gemini:gemini-2.5-flash-lite
#   EARSHOT_LLM_MODEL=anthropic:claude-haiku-4-5-20251001
# Provide the matching key via a file, not inline:
# EARSHOT_DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
# EARSHOT_GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key
# EARSHOT_ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key

# ---- Embeddings provider for dedup ----
EARSHOT_EMBED_MODEL=fake:hash-256

# ---- Per-project config is stored in the DB (projects table), including a
#      per-project fine-grained GitHub PAT scoped to a single repo with
#      "Issues: read & write". For local dev you may seed one via a file: ----
# EARSHOT_SEED_PROJECT_GITHUB_TOKEN_FILE=/run/secrets/project_github_pat
